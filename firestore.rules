rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validWorkspace(data) {
      return data.keys().hasOnly(['schemaVersion', 'canvasOrder', 'orderRevision',
          'updatedAt', 'canvases'])
        && data.schemaVersion == 2 && data.canvasOrder is list
        && data.canvasOrder.size() <= 5000 && data.orderRevision is int
        && data.orderRevision > 0 && data.updatedAt == request.time
        && (!data.keys().hasAny(['canvases']) || data.canvases is list);
    }
    function validLegacyWorkspace(data) {
      return data.keys().hasOnly(['canvases', 'updatedAt'])
        && data.canvases is list && data.updatedAt == request.time;
    }
    function validSections(values) {
      return values is list && values.size() == 12
        && values[0].id == 'problem' && values[1].id == 'alternatives'
        && values[2].id == 'solution' && values[3].id == 'metrics'
        && values[4].id == 'value' && values[5].id == 'concept'
        && values[6].id == 'advantage' && values[7].id == 'channels'
        && values[8].id == 'segments' && values[9].id == 'adopters'
        && values[10].id == 'cost' && values[11].id == 'revenue';
    }
    function validCanvas(data) {
      return data.keys().hasOnly(['schemaVersion', 'name', 'title', 'favorite', 'notes',
          'about', 'sections', 'revision', 'updatedAt', 'legacyId'])
        && data.schemaVersion == 1 && data.name is string && data.name.size() <= 500
        && data.title is string && data.title.size() <= 500
        && data.favorite is bool && data.notes is string && data.notes.size() <= 100000
        && (!data.keys().hasAny(['about']) || (data.about is string && data.about.size() <= 100000))
        && validSections(data.sections) && data.revision is int && data.revision > 0
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['legacyId']) || data.legacyId is string);
    }
    match /users/{userId}/workspaces/{workspaceId} {
      allow read: if owner(userId) && workspaceId == 'default';
      allow create: if owner(userId) && workspaceId == 'default' && (
        (validWorkspace(request.resource.data) && request.resource.data.orderRevision == 1)
        || validLegacyWorkspace(request.resource.data));
      allow update: if owner(userId) && workspaceId == 'default' && (
        (validWorkspace(request.resource.data) &&
          ((resource.data.schemaVersion == 2 && request.resource.data.orderRevision == resource.data.orderRevision + 1)
            || (!resource.data.keys().hasAny(['schemaVersion']) && request.resource.data.orderRevision == 1)))
        || (!resource.data.keys().hasAny(['schemaVersion'])
          && validLegacyWorkspace(request.resource.data)));
      allow delete: if false;
      match /canvases/{canvasId} {
        allow read: if owner(userId) && workspaceId == 'default';
        allow create: if owner(userId) && workspaceId == 'default'
          && validCanvas(request.resource.data) && request.resource.data.revision == 1
          && ((!exists(/databases/$(database)/documents/users/$(userId)/workspaces/default))
            || !get(/databases/$(database)/documents/users/$(userId)/workspaces/default).data.keys().hasAny(['schemaVersion'])
            || canvasId in getAfter(/databases/$(database)/documents/users/$(userId)/workspaces/default).data.canvasOrder);
        function boardRef() {
          return /databases/$(database)/documents/users/$(userId)/workspaces/default/canvases/$(canvasId)/boards/default;
        }
        allow update: if owner(userId) && workspaceId == 'default'
          && validCanvas(request.resource.data)
          && (!exists(boardRef()) || get(boardRef()).data.status != 'deleting')
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if owner(userId) && workspaceId == 'default'
          && !(canvasId in getAfter(/databases/$(database)/documents/users/$(userId)/workspaces/default).data.canvasOrder)
          && !existsAfter(boardRef());
        match /boards/{boardId} {
          function ownsBoard() { return owner(userId) && workspaceId == 'default' && boardId == 'default'; }
          // Issued only by a trusted Firebase Admin provisioner, never by clients.
          function commentAgent() {
            return request.auth != null && workspaceId == 'default' && boardId == 'default'
              && request.auth.token.keys().hasAll(['leanRole', 'leanOwnerId', 'leanCanvasId', 'leanAgentName'])
              && request.auth.token.leanRole == 'commenter'
              && request.auth.token.leanOwnerId == userId
              && request.auth.token.leanCanvasId == canvasId;
          }
          function readsBoard() { return ownsBoard() || commentAgent(); }
          function canvasRef() {
            return /databases/$(database)/documents/users/$(userId)/workspaces/default/canvases/$(canvasId);
          }
          function validActivityCount(value) {
            return value is int && value >= 0 && value <= 1000000;
          }
          function validActivity(activity) {
            return activity is map && activity.keys().hasOnly(['throughDay', 'counts', 'timeZone'])
              && (!activity.keys().hasAny(['timeZone']) || activity.timeZone == 'Asia/Kolkata')
              && activity.throughDay is int && activity.throughDay >= 0
              && activity.counts is list && activity.counts.size() == 7
              && validActivityCount(activity.counts[0]) && validActivityCount(activity.counts[1])
              && validActivityCount(activity.counts[2]) && validActivityCount(activity.counts[3])
              && validActivityCount(activity.counts[4]) && validActivityCount(activity.counts[5])
              && validActivityCount(activity.counts[6]);
          }
          function validBoard(data) {
            return data.keys().hasOnly(['schemaVersion', 'canvasId', 'revision', 'columns',
                'status', 'importId', 'deletingCardId', 'updatedAt', 'activity'])
              && data.schemaVersion == 1 && data.canvasId == canvasId
              && data.revision is int && data.revision > 0
              && data.columns is list && data.columns.size() <= 100
              && data.status in ['active', 'importing', 'deleting', 'deleting-card']
              && data.importId is string && data.deletingCardId is string
              && data.updatedAt == request.time
              && (!data.keys().hasAny(['activity']) || validActivity(data.activity));
          }
          function writable() {
            let before = get(boardRef()).data;
            let after = getAfter(boardRef()).data;
            return existsAfter(canvasRef()) && (
              (before.status == 'active' && after.status == 'active' && after.revision == before.revision + 1)
              || (before.status == 'importing' && after.status == 'importing'));
          }
          function validCard(data) {
            return data.keys().hasOnly(['schemaVersion', 'canvasId', 'columnId', 'title', 'description', 'storyPoints', 'parentTicketId', 'rank', 'updatedAt'])
              && data.schemaVersion == 1 && data.canvasId == canvasId
              && data.columnId is string && data.columnId.size() > 0
              && data.title is string && data.title.size() > 0 && data.title.size() <= 500
              && data.description is string && data.description.size() <= 100000
              && (!data.keys().hasAny(['storyPoints']) || data.storyPoints == null
                || (data.storyPoints is int && data.storyPoints in [1, 3, 5, 8, 13]))
              && data.rank is string && data.rank.matches('^[0-9a-z]*[1-9a-z]$') && data.rank.size() <= 2048
              && data.updatedAt == request.time;
          }
          function canDeleteCard(cardId) {
            let board = get(boardRef()).data;
            return board.status == 'deleting' ||
              (board.status == 'deleting-card' && board.deletingCardId == cardId);
          }
          allow read: if readsBoard();
          allow create: if ownsBoard() && existsAfter(canvasRef())
            && validBoard(request.resource.data) && request.resource.data.revision == 1
            && request.resource.data.status in ['active', 'importing', 'deleting'];
          allow update: if ownsBoard() && existsAfter(canvasRef()) && validBoard(request.resource.data)
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.importId == resource.data.importId
            && resource.data.status != 'deleting';
          allow update: if commentAgent() && existsAfter(canvasRef()) && validBoard(request.resource.data)
            && resource.data.status == 'active' && request.resource.data.status == 'active'
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision', 'updatedAt']);
          allow delete: if ownsBoard() && resource.data.status == 'deleting' && !existsAfter(canvasRef());
          match /cards/{cardId} {
            function validParent(data) {
              return !data.keys().hasAny(['parentTicketId']) || data.parentTicketId == null ||
                (data.parentTicketId is string && data.parentTicketId != cardId
                  && data.parentTicketId.matches('^[^/]+$')
                  && exists(/databases/$(database)/documents/users/$(userId)/workspaces/default/canvases/$(canvasId)/boards/default/cards/$(data.parentTicketId)));
            }
            allow read: if readsBoard();
            // Parent links are set at creation. Existing tickets cannot be reparented into cycles.
            allow create: if ownsBoard() && writable() && validCard(request.resource.data) && validParent(request.resource.data);
            allow update: if ownsBoard() && writable() && validCard(request.resource.data)
              && request.resource.data.get('parentTicketId', null) == resource.data.get('parentTicketId', null);
            allow delete: if ownsBoard() && canDeleteCard(cardId);
          }
          match /comments/{commentId} {
            function validComment(data) {
              return data.keys().hasOnly(['schemaVersion', 'canvasId', 'cardId', 'authorId', 'authorName', 'authorType', 'text', 'createdAt', 'updatedAt'])
                && data.schemaVersion == 1 && data.canvasId == canvasId
                && data.cardId is string
                && existsAfter(/databases/$(database)/documents/users/$(userId)/workspaces/default/canvases/$(canvasId)/boards/default/cards/$(data.cardId))
                && data.authorId is string && data.authorId.size() > 0
                && (get(boardRef()).data.status == 'importing' || data.authorId == request.auth.uid)
                && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 500
                && (!data.keys().hasAny(['authorType']) || data.authorType in ['user', 'agent'])
                && (ownsBoard() || (data.authorType == 'agent' && data.authorName == request.auth.token.leanAgentName))
                && data.text is string && data.text.size() > 0 && data.text.size() <= 10000
                && data.text.matches('(?s).*\\S.*')
                && data.createdAt is string && data.createdAt.size() <= 40 && data.updatedAt == request.time;
            }
            allow read: if readsBoard();
            allow create: if (ownsBoard() || (commentAgent() && get(boardRef()).data.status == 'active'))
              && writable() && validComment(request.resource.data);
            allow update: if ownsBoard() && get(boardRef()).data.status == 'importing'
              && writable() && validComment(request.resource.data);
            allow delete: if ownsBoard() && canDeleteCard(resource.data.cardId);
          }
        }
      }
    }
  }
}
