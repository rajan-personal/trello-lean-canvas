{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trello-lean-canvas",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "main": "server/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DATA_BACKEND": "firestore", "WRITES_ENABLED": "false", "AUTH_REGISTRATION_ENABLED": "false" },
  "routes": [
    { "pattern": "lean.addorimprove.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
