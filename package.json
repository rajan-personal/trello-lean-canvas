{
  "name": "trello-lean-canvas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:comments-preview": "vite build --config vite.comments-preview.config.ts",
    "preview:comments": "vite preview --config vite.comments-preview.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:firebase": "npx -y firebase-tools@15.28.2 deploy --only auth,firestore",
    "test": "vitest run",
    "test:firestore": "node scripts/run-firestore-tests.mjs",
    "comment:agent": "node --experimental-strip-types scripts/comment-agent.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "preview:worker": "wrangler dev --local"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^3.2.7",
    "agentation": "^3.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  }
}
